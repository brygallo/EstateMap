*.log

# Video factory: keep plans, scripts, reviews, catalogs and result data in Git;
# exclude generated or supplied binary media from each local production.
marketing/videos/library/**/*.mp4
marketing/videos/library/**/*.mov
marketing/videos/library/**/*.m4v
marketing/videos/library/**/*.webm
marketing/videos/library/**/*.mp3
marketing/videos/library/**/*.wav
marketing/videos/library/**/*.aiff
marketing/videos/library/**/*.m4a
marketing/videos/library/**/*.png
marketing/videos/library/**/*.jpg
marketing/videos/library/**/*.jpeg
marketing/videos/library/**/*.webp
marketing/videos/library/_outbox/
marketing/videos/remotion/public/jobs/
marketing/videos/remotion/public/fonts/
marketing/videos/remotion/public/brand/aents-symbol-negative.png

# Portal captures are regenerated by capture-screens; the manifest is versioned
marketing/videos/assets/screens/*.mp4
marketing/videos/assets/screens/*.webm
# Licensed source music stays local; license metadata remains versioned
marketing/videos/assets/music/*.mp3
marketing/videos/.venv/
marketing/videos/.cache/

# Local property/media samples
backend/properties/
# Runtime staging for pending uploads; these files belong to the local service,
# never to a source deployment.
backend/tmp/

# Spec tooling virtualenv (see scripts/specs.sh)
.venv-specs/

# Playwright suite (see tests/README.md)
tests/node_modules/
tests/playwright-report/
tests/test-results/
