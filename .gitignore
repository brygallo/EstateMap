marketing/videos/library/**/*.png
marketing/videos/library/**/*.jpg
marketing/videos/library/**/*.jpeg
marketing/videos/library/**/*.webp

# Local property/media samples
backend/properties/
# Runtime staging for pending uploads; these files belong to the local service,
# never to a source deployment.
backend/tmp/

