# Restoring the visitor's address behind the CDN
# ============================================================
# This file is the reference copy. On the production host it lives at
# /etc/nginx/snippets/cloudflare-realip.conf, is regenerated by
# deploy/cloudflare-ips-refresh.sh, and is pulled in with a single line inside
# each geopropiedades server block:
#
#     include /etc/nginx/snippets/cloudflare-realip.conf;
#
# WHY THIS IS NOT OPTIONAL
#
# Anonymous rate limiting identifies a visitor by the last hop of
# X-Forwarded-For, because that is the only entry a client cannot forge: nginx
# appends it (see REST_FRAMEWORK NUM_PROXIES=1 and PERM-072).
#
# Put a CDN in front and the chain becomes «visitor, edge». The last hop is
# then the edge, and since one region is served by a handful of edge
# addresses, hundreds of unrelated visitors would share a single throttle
# bucket and start collecting 429s on a normal afternoon.
#
# `real_ip` fixes it before Django ever sees the request: nginx replaces the
# address it observed with the one the CDN reports, so the hop it appends is
# the visitor again and every rate limit keeps working per person.
#
# THE TRUST BOUNDARY
#
# CF-Connecting-IP is only meaningful when the connection really comes from the
# CDN. `set_real_ip_from` is what enforces that: outside those ranges the
# header is ignored, so nobody can hand you an address by sending the header
# themselves. Verified from a home connection: a request carrying a forged
# `CF-Connecting-IP: 1.2.3.4` still logged the real address.
#
# WHY PER SERVER BLOCK AND NOT IN `http`
#
# This host also serves aents.net and miyomehabla.com, which are not behind the
# CDN. The directives would be harmless there — their traffic never arrives
# from a Cloudflare range — but the include stays inside the two
# geopropiedades blocks so the blast radius of a bad IP list is one site.
#
# AND DO NOT CLOSE 80/443 TO CLOUDFLARE RANGES
#
# The usual next step is to firewall the origin so only the CDN can reach it.
# Do not do it on this box. The same nginx answers aents.net,
# miyomehabla.com, the mailserver and MinIO, and none of them is proxied: a
# global rule would take all of them down. If origin bypass has to be closed,
# it has to be closed per server block — `allow` the Cloudflare ranges and
# `deny all` inside the two geopropiedades blocks only.

# --- Generated block (see deploy/cloudflare-ips-refresh.sh) ---
set_real_ip_from 173.245.48.0/20;
set_real_ip_from 103.21.244.0/22;
set_real_ip_from 103.22.200.0/22;
set_real_ip_from 103.31.4.0/22;
set_real_ip_from 141.101.64.0/18;
set_real_ip_from 108.162.192.0/18;
set_real_ip_from 190.93.240.0/20;
set_real_ip_from 188.114.96.0/20;
set_real_ip_from 197.234.240.0/22;
set_real_ip_from 198.41.128.0/17;
set_real_ip_from 162.158.0.0/15;
set_real_ip_from 104.16.0.0/13;
set_real_ip_from 104.24.0.0/14;
set_real_ip_from 172.64.0.0/13;
set_real_ip_from 131.0.72.0/22;
set_real_ip_from 2400:cb00::/32;
set_real_ip_from 2606:4700::/32;
set_real_ip_from 2803:f800::/32;
set_real_ip_from 2405:b500::/32;
set_real_ip_from 2405:8100::/32;
set_real_ip_from 2a06:98c0::/29;
set_real_ip_from 2c0f:f248::/32;
real_ip_header CF-Connecting-IP;
real_ip_recursive on;

# HOW TO VERIFY IT WORKED
#
# 1. From two different networks — a phone on mobile data and a laptop on
#    wifi — request a page and read the access log. Two different addresses
#    must appear. One repeated Cloudflare address means the header is not
#    being trusted and the throttle is now shared.
#
#      tail -f /var/log/nginx/access.log | awk '{print $1}'
#
# 2. Confirm the header cannot be forged from outside the ranges:
#
#      curl -s -o /dev/null -H 'CF-Connecting-IP: 1.2.3.4' https://geopropiedadesecuador.com/robots.txt
#      # the log must show your own address, never 1.2.3.4
#
# 3. Only then enable caching rules at the CDN. Cache before you have verified
#    identity and you will be debugging two problems at once.
