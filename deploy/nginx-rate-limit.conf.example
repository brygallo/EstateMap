# ============================================================
# Rate limit response configuration
# ============================================================
# The above limit_req_status 429 will return HTTP 429 (Too Many Requests)
# with this error page:
#
# error_page 429 =429 @rate_limit_reached;
# location @rate_limit_reached {
#     default_type application/json;
#     return 429 '{"error": "Too many requests. Please try again later."}';
# }

# ============================================================
# How this works
# ============================================================
# 1. $limit geo map checks client IP against exemption list
#    - Docker containers (internal IPs) → $limit=0 (exempt)
#    - Public/external IPs → $limit=1 (rate-limited)
#
# 2. $limit_key map converts $limit to:
#    - 0 → empty string (nginx skips rate-limit zones with empty key)
#    - 1 → $binary_remote_addr (tracks by external IP)
#
# 3. limit_req zone=... applies the zone:
#    - burst=30: allow up to 30 extra requests in queue
#    - nodelay: process queued requests immediately (don't delay)
#    - If exceeded, return 429
#
# 4. Next.js SSR calls from Docker → private IP → $limit=0 → no limiting
#    External browser/API calls → public IP → $limit=1 → rate limited

# ============================================================
# Testing the configuration
# ============================================================
# 1. SSH to prod host as root:
#    ssh -i ~/.ssh/prod_key root@contabo_prod_ip
#
# 2. Backup current nginx config:
#    cp /etc/nginx/nginx.conf /etc/nginx/nginx.conf.backup
#
# 3. Merge the zone definitions and location blocks above into
#    /etc/nginx/nginx.conf or the included server block
#
# 4. Test syntax:
#    nginx -t
#
# 5. Reload (zero-downtime):
#    systemctl reload nginx
#
# 6. Check limits are working:
#    # From external IP (will be limited):
#    for i in {1..15}; do curl -s -w "%{http_code}\n" http://geopropiedadesecuador.com/api/properties/ | tail -1; done
#    # Should see some 429 responses after ~5 requests
#
# 7. Docker containers are NOT limited (internal IPs):
#    # From within Docker:
#    docker exec backend curl -s http://nginx-internal-ip/api/properties/
#    # Should always get 200, never 429
