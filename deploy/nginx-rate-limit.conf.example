# nginx Rate Limiting Configuration for EstateMap Production
# ============================================================
# This is an EXAMPLE configuration snippet. It must be merged into
# the real server block on the prod host, NOT deployed as-is.
# After merging, test with: nginx -t
# Then reload: systemctl reload nginx
#
# IMPORTANT NOTES:
# - Nginx native (not Docker) runs on the Contabo prod host
# - These rules protect API endpoints from scrapers and bots
# - map_points: map visualization (stricter: 5r/s, burst 20)
# - property_list: property listing (moderate: 10r/s, burst 30)
# - Localhost and private IPs (Docker/Next.js SSR) are EXEMPT
#
# Rate limit zones - define shared state for limiting
# Each zone: 10MB memory ≈ 160k requests in memory at once
limit_req_zone $limit_key zone=api_general:10m rate=10r/s;
limit_req_zone $limit_key zone=api_map:10m rate=5r/s;

# Geo-IP map: exempt localhost and private ranges
# Maps to 0 (exempt) or 1 (rate-limited)
geo $limit {
    default 1;
    127.0.0.1 0;           # localhost
    10.0.0.0/8 0;          # Docker internal
    172.16.0.0/12 0;       # Docker bridge range
    192.168.0.0/16 0;      # Local network
}

# Map limit to actual key: empty string (not limited) or IP (limited)
map $limit $limit_key {
    0 "";                   # exempt: empty key (bypass zone checks)
    1 $binary_remote_addr;  # rate-limit: use binary IP for efficiency
}

# ============================================================
# Server block excerpt - add these location blocks to the
# existing server block that proxies to the Docker apps
# ============================================================

