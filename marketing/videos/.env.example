# Copy to .env. Never commit real keys: .env is git-ignored.
CLAUDE_MODEL=

# --- Draft voice: free, local, unlimited -------------------------------------
# Every `video render` uses this until someone asks for a final master, so the
# script can be rewritten as many times as it takes without spending anything.
DRAFT_TTS_PROVIDER=kokoro
KOKORO_VOICE=ef_dora
KOKORO_SPEED=1.04

# macOS fallback if Kokoro is not installed: set DRAFT_TTS_PROVIDER=macos.
LOCAL_VOICE=Paulina

# --- Final voice: paid, bought once ------------------------------------------
# Only `video render <id> --final` reaches this provider. Clips are cached by
# the exact text they speak, so re-rendering an unchanged script costs nothing
# and only edited lines are ever bought again.
FINAL_TTS_PROVIDER=elevenlabs
# Both come from elevenlabs.io: the key from Settings > API Keys, the voice id
# from the voice's "..." menu > Copy voice ID once it is in My Voices.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=9F4C8ztpNUmXkdDDbz3J
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# These change the audio, so changing one buys new clips for the whole script.
ELEVENLABS_STABILITY=0.62
ELEVENLABS_SIMILARITY=0.55
ELEVENLABS_SPEED=1.02

# Ceiling per run. A 60-second piece is around 900 characters.
ELEVENLABS_MAX_CHARS_PER_RUN=2000

# --- Music -------------------------------------------------------------------
# Music is never purchased or generated. External tracks must be free for
# commercial use and include the author, source URL, and license in a sidecar.
