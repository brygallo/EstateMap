# The free/default path uses the authenticated Claude CLI and local Kokoro.
CLAUDE_MODEL=
TTS_PROVIDER=kokoro
KOKORO_VOICE=ef_dora
KOKORO_SPEED=1.04

# Optional macOS fallback.
LOCAL_VOICE=Paulina

# Future premium provider. Set TTS_PROVIDER=elevenlabs. Never commit real keys.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
